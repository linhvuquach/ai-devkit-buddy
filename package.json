{
  "name": "ai-devkit-buddy",
  "version": "2.1.7",
  "description": "A package manager for AI agent skills (Claude Code, Cursor, Codex)",
  "main": "dist/index.js",
  "bin": {
    "ai-devkit-buddy": "bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "validate-skills": "ts-node src/scripts/validate-skills.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "prompt",
    "generator",
    "cursor",
    "claude"
  ],
  "author": "linhvuquach",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linhvuquach/ai-devkit-buddy.git"
  },
  "license": "ISC",
  "files": [
    "dist",
    "bin",
    "src/templates",
    "skills/registry.json"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.0.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
  }
}
